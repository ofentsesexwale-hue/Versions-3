# Offline OVC CaseFile — copy to .env and edit before going live.
# Never commit a real DJANGO_SECRET_KEY.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
USE_SQLITE=true
# Absolute path recommended on the office PC, e.g. C:\Users\sebue\OVC-CaseFile\media
MEDIA_ROOT=
